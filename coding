// باستخدام لغة C#

using System;
using System.Collections.Generic;

namespace AppointmentSchedulingSystem
{
    // 1. تعريف الـ Enum الخاص بالأولوية
    public enum PriorityLevel
    {
        LOW = 1,
        MEDIUM = 2,
        HIGH = 3,
        EMERGENCY = 4
    }

    // 2. الموعد (Appointment)
    public class Appointment
    {
        public int AppointmentId { get; set; }
        public string PatientName { get; set; }
        public string ExamType { get; set; }
        public int Duration { get; set; } // minutes
        public string DeviceName { get; set; }
        public string AppointmentTime { get; set; }
        public PriorityLevel Priority { get; set; }
        public string PreparationInstructions { get; set; }
        public bool Confirmed { get; set; }

        public Appointment(int id, string patient, string exam, int dur, string device, string time, PriorityLevel pr, string prep)
        {
            AppointmentId = id;
            PatientName = patient;
            ExamType = exam;
            Duration = dur;
            DeviceName = device;
            AppointmentTime = time;
            Priority = pr;
            PreparationInstructions = prep;
            Confirmed = false;
        }
    }

    // 3.  الجهاز (Device)
    public class Device
    {
        public int DeviceId { get; set; }
        public string DeviceName { get; set; }
        public bool Available { get; set; }
        public List<string> AvailableSlots { get; set; }

        public Device(int id, string name, bool status)
        {
            DeviceId = id;
            DeviceName = name;
            Available = status;
            AvailableSlots = new List<string>(); 
        }
    }

    // 4.  نظام جدولة المواعيد (AppointmentScheduler)
    public class AppointmentScheduler
    {
        // =========================================================
        // 1. اختيار أفضل موعد تلقائيًا
        public Appointment FindBestAvailableSlot(string patientName, string examType, int duration, PriorityLevel priority, List<Device> devices)
        {
            foreach (Device device in devices)
            {
                if (device.Available && device.AvailableSlots.Count > 0)
                {
                    string bestSlot = device.AvailableSlots[0];

                    Console.WriteLine($"Best slot selected on device: {device.DeviceName}");

                    return new Appointment(
                        1,
                        patientName,
                        examType,
                        duration,
                        device.DeviceName,
                        bestSlot,
                        priority,
                        ""
                    );
                }
            }

            throw new Exception("No available slots found.");
        }

        // =========================================================
        // 2. التحقق من تعليمات التحضير
        public bool ValidatePreparationInstructions(Appointment appointment)
        {
            if (string.IsNullOrEmpty(appointment.PreparationInstructions))
            {
                Console.WriteLine("Preparation instructions are required.");
                return false;
            }

            Console.WriteLine("Preparation instructions validated successfully.");
            return true;
        }

        // =========================================================
        // 3. إعادة الجدولة عند تعطل الجهاز
        public void RescheduleAffectedAppointments(List<Appointment> appointments, string failedDevice, List<Device> devices)
        {
            Console.WriteLine($"\nDevice Failure Detected: {failedDevice}");

            foreach (Appointment appointment in appointments)
            {
                if (appointment.DeviceName == failedDevice)
                {
                    Console.WriteLine($"\nRescheduling appointment for patient: {appointment.PatientName}");

                    bool rescheduled = false;

                    foreach (Device device in devices)
                    {
                        if (device.Available && device.DeviceName != failedDevice && device.AvailableSlots.Count > 0)
                        {
                            appointment.DeviceName = device.DeviceName;
                            appointment.AppointmentTime = device.AvailableSlots[0];

                            Console.WriteLine($"New Device: {appointment.DeviceName}");
                            Console.WriteLine($"New Time: {appointment.AppointmentTime}");

                            rescheduled = true;
                            break;
                        }
                    }

                    if (!rescheduled)
                    {
                        Console.WriteLine("No alternative slots available.");
                    }
                }
            }
        }
    }

    // 5. نقطة تشغيل البرنامج
    class Program
    {
        static void Main(string[] args)
        {
            Device mri1 = new Device(1, "MRI-1", false);
            Device mri2 = new Device(2, "MRI-2", true);

            mri2.AvailableSlots.Add("10:00 AM");
            mri2.AvailableSlots.Add("11:00 AM");

            List<Device> devices = new List<Device> { mri1, mri2 };

            AppointmentScheduler scheduler = new AppointmentScheduler();

            // =========================================================
            // اختيار أفضل موعد
            try
            {
                Appointment appointment = scheduler.FindBestAvailableSlot(
                    "Rayan",
                    "MRI Brain",
                    60,
                    PriorityLevel.HIGH,
                    devices
                );

                // =========================================================
                // إضافة تعليمات التحضير
                appointment.PreparationInstructions = "Do not eat 6 hours before the exam.";

                if (scheduler.ValidatePreparationInstructions(appointment))
                {
                    appointment.Confirmed = true;
                    Console.WriteLine("\nAppointment Confirmed Successfully.");
                }

                // =========================================================
                // قائمة المواعيد
                List<Appointment> appointments = new List<Appointment>();
                appointments.Add(appointment);

                // =========================================================
                // إعادة الجدولة عند تعطل الجهاز
                scheduler.RescheduleAffectedAppointments(
                    appointments,
                    "MRI-1",
                    devices
                );
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error: {ex.Message}");
            }
        }
    }
}
